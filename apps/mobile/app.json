{
  "expo": {
    "name": "DomDepannage",
    "slug": "depannage-electrique-mobile",
    "owner": "claude972",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "depannageelectrique",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.claude972.depannageelectrique.preview",
      "buildNumber": "8",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "DomDépannage"
      }
    },
    "android": {
      "package": "com.claude972.depannageelectrique.preview",
      "versionCode": 8,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-foreground.png"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "./plugins/with-android-display-name",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash.png",
          "imageWidth": 174
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Autorisez l’accès aux photos pour joindre les preuves de l’intervention.",
          "cameraPermission": "Autorisez l’appareil photo pour prendre une preuve avant ou après l’intervention.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Autorisez la localisation pour proposer une adresse d’intervention."
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "70af13e9-0f42-410f-93c9-f53b8966e056"
      }
    }
  }
}
