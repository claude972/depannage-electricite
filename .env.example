# Public project configuration, never a service key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only values; never prefix secrets with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Web Push. Enable only with the database delivery gate and a matching HTTPS site origin.
NOTIFICATIONS_PUSH_PROVIDER=
NOTIFICATION_VAPID_SUBJECT=
NOTIFICATION_VAPID_PUBLIC_KEY=
NOTIFICATION_VAPID_PRIVATE_KEY=
# Optional marketplace commission. Configure only after business approval.
PLATFORM_FEE_BPS=

# Country must match the legal marketplace onboarding configuration (ISO alpha-2)
STRIPE_CONNECT_COUNTRY=
# Keep false until commercial, legal and payment tests are approved
STRIPE_LIVE_PAYMENTS_ENABLED=false

# Separate gates for settlement and read-back proofs. Keep provider and database gates disabled until test-mode validation.
GUEST_SETTLEMENT_ENABLED=false
GUEST_SETTLEMENT_LIVE_ENABLED=false
STRIPE_CHARGE_PROOF_ENABLED=false
STRIPE_PAYOUT_PROOF_ENABLED=false

# Requires validated guarantee terms and matching service-only DB setting
WARRANTY_REQUESTS_ENABLED=false

# Optional Resend delivery. Keep the database gate disabled until receipt tests pass.
NOTIFICATIONS_EMAIL_PROVIDER=
NOTIFICATION_RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=
NOTIFICATION_DELIVERY_SECRET=

# Optional subscriptions. No offers or Billing modes are enabled by default.
SUBSCRIPTIONS_ENABLED=false
STRIPE_BILLING_PORTAL_CONFIGURATION_TEST=
STRIPE_BILLING_PORTAL_CONFIGURATION_LIVE=
STRIPE_BILLING_WEBHOOK_SECRET_TEST=
STRIPE_BILLING_WEBHOOK_SECRET_LIVE=

# Optional private photo preclassification. Disabled until consent and provider tests are complete.
PHOTOTRIAGE_ENABLED=false
PHOTOTRIAGE_MODEL=
OPENAI_API_KEY=

# Enable only once the operator can process callbacks and the public notice is configured.
PUBLIC_CALLBACK_INTAKE_ENABLED=false
